# PostgreSQL
DATABASE_URL="postgresql://gtm:password@localhost:5432/gtm_db?schema=public"

# App
PORT=3001
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:3000

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Twilio (optional - SMS verification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Public URL Twilio calls for inbound SMS. Used to validate X-Twilio-Signature
# when the app sits behind a proxy that rewrites host/protocol.
# e.g. https://api.ovrlap.app/sms/inbound
SMS_WEBHOOK_PUBLIC_URL=

# Returns the OTP in the API response. Ignored when NODE_ENV=production.
# Never enable on a shared environment.
LOG_PHONE_VERIFICATION_CODE=

# --- Isolated test environments only -------------------------------------
# Suppresses outbound SMS for allow-listed numbers and uses a fixed code.
# The code is still hashed, stored, expired and CHECKED — wrong codes are
# still rejected and no number is verified without a valid check.
# The app REFUSES TO START if SMS_TEST_MODE=true while NODE_ENV=production.
SMS_TEST_MODE=
SMS_TEST_CODE=
SMS_TEST_PHONE_ALLOWLIST=

# Redis (optional - Socket.IO multi-instance adapter)
REDIS_URL=

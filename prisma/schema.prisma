generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Admin
  OEM
  Reseller
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  company      String?
  roles        UserRole[] @default([])
  hasCompletedOnboarding Boolean @default(false)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Email verification
  emailVerified                  Boolean   @default(false)
  emailVerificationCode          String?
  emailVerificationCodeExpiresAt DateTime?
  emailVerificationAttempts      Int       @default(0)
  lastVerificationCodeSentAt     DateTime?

  // Phone verification
  phoneNumber                    String?
  isPhoneVerified                Boolean   @default(false)
  phoneVerificationCode          String?
  phoneVerificationCodeExpiresAt DateTime?
  phoneVerificationAttempts      Int       @default(0)
  lastPhoneVerificationCodeSentAt DateTime?

  // Password reset
  passwordResetToken             String?
  passwordResetTokenExpiresAt    DateTime?
  passwordResetAttempts          Int       @default(0)
  lastPasswordResetRequestAt     DateTime?

  accountLists       AccountList[]
  sentConnections    Connection[]  @relation("SentConnections")
  receivedConnections Connection[] @relation("ReceivedConnections")
  sentInvites        Invite[]     @relation("SentInvites")
  acceptedInvites    Invite[]     @relation("AcceptedInvites")
  notifications       Notification[]
  observedOverlapNotifications ObservedOverlapNotification[]

  @@map("users")
}

model AccountList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  status    String   @default("draft") // draft, active
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
  @@map("account_lists")
}

model Account {
  id            String  @id @default(cuid())
  accountListId String
  accountName   String
  normalizedName String
  type          String? // customer, prospect, null
  createdAt     DateTime @default(now())

  accountList AccountList @relation(fields: [accountListId], references: [id], onDelete: Cascade)

  @@index([accountListId])
  @@index([normalizedName])
  @@map("accounts")
}

model Connection {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  status      String   @default("pending") // pending, accepted, rejected
  senderMutedAt                DateTime?
  receiverMutedAt              DateTime?
  senderMutedMatchCount        Int?
  receiverMutedMatchCount      Int?
  lastObservedSharedMatchCount Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender   User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)
  matchDecisions AccountMatchDecision[]
  observedOverlapNotifications ObservedOverlapNotification[]

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@map("connections")
}

model ObservedOverlapNotification {
  id                   String   @id @default(cuid())
  userId               String
  connectionId         String
  senderNormalizedName String
  receiverNormalizedName String
  createdAt            DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, connectionId, senderNormalizedName, receiverNormalizedName])
  @@index([connectionId, userId])
  @@map("observed_overlap_notifications")
}

model AccountMatchDecision {
  id           String   @id @default(cuid())
  connectionId String
  yourAccountId String
  theirAccountId String
  yourNormalizedNameSnapshot String?
  theirNormalizedNameSnapshot String?
  decision     String // accepted, rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, yourAccountId, theirAccountId])
  @@index([connectionId])
  @@map("account_match_decisions")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  ctaUrl    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Invite {
  id              String    @id @default(cuid())
  invitedEmail    String
  invitedName     String?
  invitedByUserId String
  tokenHash       String    @unique
  status          String    @default("pending") // pending, accepted, expired, revoked
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedByUserId String?

  invitedBy   User  @relation("SentInvites", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy  User? @relation("AcceptedInvites", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([invitedByUserId])
  @@index([invitedEmail])
  @@index([tokenHash])
  @@map("invites")
}
